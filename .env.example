# All optional — the site renders without any of these; each feature
# degrades gracefully when its keys are absent (see lib/kv, lib/email).

# Upstash Redis (free tier): contact rate limiting + case-study view counters.
# Without these, rate limiting FAILS OPEN (logged loudly) and view counters hide.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend: contact form delivery. Without these, sends go to a dev log stub.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional: raises GitHub API rate limits for the activity tiles.
# Public data works unauthenticated; ISR (~1h) keeps usage minimal.
GITHUB_TOKEN=
