# Copy to terraform.tfvars (gitignored — *.tfvars never commits) and fill
# in the values Resend shows after you add the domain in its dashboard.
# Use exactly what the dashboard lists; names here are fully qualified.

resend_records = [
  # DKIM — domain verification. The p= value is long; paste it whole.
  {
    name  = "resend._domainkey.damienfarrar.com"
    type  = "TXT"
    value = "p=MIGfMA0GCSq..." # copy the full key from the dashboard
  },
  # SPF for the sending subdomain
  {
    name  = "send.damienfarrar.com"
    type  = "TXT"
    value = "v=spf1 include:amazonses.com ~all" # copy from dashboard
  },
  # Bounce / complaint MX for the sending subdomain (region-specific host)
  {
    name  = "send.damienfarrar.com"
    type  = "MX"
    value = "10 feedback-smtp.REGION.amazonses.com" # copy from dashboard
  },
  # DMARC — Resend lists this as optional; p=none is monitor-only, safe to start
  {
    name  = "_dmarc.damienfarrar.com"
    type  = "TXT"
    value = "v=DMARC1; p=none;"
  },
]

# Copy to terraform.tfvars and fill in from the Workspace admin console
# (Apps > Google Workspace > Gmail > Authenticate email). Only outbound
# auth — inbound MX already exists in the zone and isn't managed here.

google_workspace_records = [
  # SPF — authorizes Google's servers to send as this domain
  {
    name  = "damienfarrar.com"
    type  = "TXT"
    value = "v=spf1 include:_spf.google.com ~all"
  },
  # DKIM — paste the full key from the admin console. Route 53 caps a TXT
  # record at 255 chars per quoted string, and Workspace keys usually run
  # longer, so split it into consecutive quoted strings like this — DNS
  # concatenates them back together:
  # value = "\"v=DKIM1; k=rsa; p=<first 255 chars>\" \"<the rest>\""
  {
    name  = "google._domainkey.damienfarrar.com"
    type  = "TXT"
    value = "v=DKIM1; k=rsa; p=..." # copy the full key from the admin console
  },
]
